# PostgreSQL connection string (Neon / Supabase / AWS RDS / local PostgreSQL)
DATABASE_URL="postgresql://username:password@ep-your-database.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://username:password@ep-your-database.region.aws.neon.tech/neondb?sslmode=require"

# Secret token for authentication sessions
NEXTAUTH_SECRET="your-secure-random-secret-key-min-32-chars"

# Clinic branding and localization
NEXT_PUBLIC_APP_NAME="A-Class Dental OS"
NEXT_PUBLIC_CLINIC_LOCATION="Kom Ombo / Aswan, Egypt"
NEXT_PUBLIC_DEFAULT_CURRENCY="EGP"
